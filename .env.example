# -----------------------------------------------------------------------------
# UNFALLEN - Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local para desenvolvimento local.
# NUNCA insira chaves reais neste arquivo ou realize commit do .env.local.
# -----------------------------------------------------------------------------

# --- MONGODB ---
# URI de conexão do MongoDB Atlas (Somente Server-Side)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/unfallen?retryWrites=true&w=majority

# --- FIREBASE CLIENT-SIDE (Expostas ao Navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_firebase_project_id

# --- FIREBASE ADMIN SDK (Somente Server-Side) ---
FIREBASE_PROJECT_ID=unfallen-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@unfallen-app.iam.gserviceaccount.com
# A chave privada RSA deve conter quebras de linha literais (\n) se configurada em strings
FIREBASE_PRIVATE_KEY="replace_with_firebase_private_key_escaped_newlines"

# --- GAMEPLAY & CHEATS CONTROL ---
# Flag para controle físico do painel de debug (NEXT_PUBLIC_ para ler no Phaser Canvas)
# Defina como true apenas em desenvolvimento/teste local.
NEXT_PUBLIC_ENABLE_DEV_CHEATS=false
